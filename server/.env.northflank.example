# ZoolChat v0.30+ Northflank runtime template
# Never commit real secrets. Configure them in Northflank's secret/environment UI.

PORT=8080
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Firebase Admin is required for FCM push delivery when Android is backgrounded/killed by the OS.
# Paste the complete service-account JSON as ONE secret value in Northflank.
FIREBASE_SERVICE_ACCOUNT_JSON={}

# LiveKit Cloud or self-hosted LiveKit.
LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ZoolChat currently uses free account auth for the private beta; Firebase is used for push.
FREE_AUTH_ENABLED=true
FIREBASE_AUTH_ENABLED=false
DEV_AUTH_ENABLED=false

# Push/privacy defaults.
PUSH_MESSAGE_PREVIEWS=false

# Network/security defaults.
TRUST_PROXY=true
CORS_ORIGINS=
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
MESSAGE_RATE_LIMIT_PER_MINUTE=120
MEDIA_RATE_LIMIT_PER_MINUTE=30
DISCOVERY_RATE_LIMIT_PER_MINUTE=20
CALL_RATE_LIMIT_PER_5_MINUTES=30
CALL_RING_TIMEOUT_SECONDS=60
TYPING_RATE_LIMIT_PER_MINUTE=180

# Media: local disk is acceptable only for a small pilot.
MEDIA_DIR=./data/media
MAX_MEDIA_MB=40

ACCESS_TOKEN_TTL_MINUTES=60
REFRESH_TOKEN_TTL_DAYS=30
